# Primary video generator. Keep the real key in your deployment secret manager.
VIDEO_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-H3-Max
MINIMAX_RESOLUTION=768P
MINIMAX_DURATION=15
MINIMAX_RATIO=16:9

# Optional MiniMax tuning.
# MINIMAX_POLL_INTERVAL_MS=10000
# MINIMAX_POLL_TIMEOUT_MS=900000
# MINIMAX_MAX_PROMPT_CHARS=2000

# Only used with VIDEO_PROVIDER=renderer.
# PYTHON_API_URL=http://127.0.0.1:8000
